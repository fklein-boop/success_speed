# ---------- Obligatoire ----------
# Base PostgreSQL (Neon, région Frankfurt). Laisser vide en local : une base PGlite est créée dans .data/
DATABASE_URL=
# Premier super admin (ne peut être ni supprimé ni rétrogradé depuis l'interface)
SUPERADMIN_EMAIL=prenom.nom@speedmedia.example
# URL publique de l'application (ex. https://audit-csm.vercel.app). En local : http://localhost:3000
APP_URL=http://localhost:3000
# Secret aléatoire (32+ caractères) pour signer les jetons — `openssl rand -base64 32`
AUTH_SECRET=

# ---------- Emails (Resend, région UE) ----------
# Sans clé, les liens de connexion s'affichent dans les logs du serveur (développement uniquement)
RESEND_API_KEY=
EMAIL_FROM="Audit CSM SpeedResa <audit@votre-domaine.fr>"

# ---------- SSO Google (facultatif) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Tâches planifiées Vercel ----------
CRON_SECRET=

# ---------- Pré-audit (scan des sites) ----------
# inline (défaut) : le scan tourne sur Vercel après la réponse, sans navigateur (mode dégradé)
# worker : le scan est mis en file et exécuté par le worker Playwright (Dockerfile.worker)
SCAN_MODE=inline
# Page présentant le robot SpeedmediaAuditBot (affichée dans son user-agent)
SCAN_CONTACT_URL=https://www.speedmedia.fr/audit-bot
# « non » pour désactiver le navigateur même s'il est installé
SCAN_NAVIGATEUR=
# « oui » pour parcourir le tunnel de réservation (PERF-01 : assurance). Désactivé par défaut :
# à activer après un essai supervisé (voir DECISIONS.md). Jamais de saisie, jamais de paiement.
SCAN_TUNNEL=
# « non » pour couper le monitoring de disponibilité du worker (TECH-04, toutes les 15 min)
SCAN_MONITORING=
# « non » pour ne pas tester la visibilité dans les moteurs de réponse IA (INN-01, 3 recherches web par scan)
SCAN_VISIBILITE_IA=

# ---------- Clés d'API ----------
ANTHROPIC_API_KEY=
# Modèle Claude (analyse des pages légales, des fiches produits, recherche INN-01)
ANTHROPIC_MODEL=claude-sonnet-5-5
GOOGLE_PAGESPEED_API_KEY=
# API Places (New) à activer dans Google Cloud : note et avis Google (VIS-01 à VIS-03)
GOOGLE_PLACES_API_KEY=
# Google Analytics 4 (propriété consolidée, lecture seule) : clé JSON du compte de service audit-csm@audit-speedresa.iam.gserviceaccount.com.
# En local : chemin du fichier (gardé HORS du projet). Sur Vercel : GA4_CREDENTIALS = contenu du fichier JSON (secret).
GA4_CREDENTIALS_FILE=
GA4_CREDENTIALS=
# Facultatif : identifiant numérique de la propriété (sinon choisie dans Administration → Google Analytics)
GA4_PROPERTY_ID=
